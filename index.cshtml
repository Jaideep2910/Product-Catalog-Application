@model IEnumerable<productcatelog.Models.product>

@{
    ViewBag.Title = "Index";
    Layout = null;
}

<h2>Product Catalog</h2>
<h1>Darsh Chandarana 92510120031</h1>

<table border="1">
    <thead>
        <tr>
            <th>Product Id</th>
            <th>Product Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
                <td>@product.Category</td>
                <td>
                    @Html.ActionLink("View Details", "Details", "Product", new { id = product.ProductId }, null)
                </td>
            </tr>
        }
    </tbody>
</table>
